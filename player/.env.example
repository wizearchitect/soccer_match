# =============================================================================
# Agent Control Panel (single player) Configuration
# Copy this file to .env and fill in your value:
#   Windows:        copy .env.example .env
#   macOS/Linux:    cp .env.example .env
# =============================================================================

# --- NVIDIA API (required) ---
# Your NVIDIA NIM API key. Get one at https://build.nvidia.com/
# Must be non-empty or the dashboard will refuse to start.
NVIDIA_API_KEY=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

