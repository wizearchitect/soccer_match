# =============================================================================
# The Pitch (game server) Configuration
# This file is OPTIONAL. The server runs fine with no .env using the defaults
# below. Copy to .env only if you need to override them:
#   Windows:        copy .env.example .env
#   macOS/Linux:    cp .env.example .env
# =============================================================================

# --- Network ---
# Interface the server binds to.
#   0.0.0.0  = accept connections from any machine on the LAN (multi-PC setup)
#   127.0.0.1 = local machine only
# Default: 0.0.0.0
HOST=0.0.0.0

# TCP port the FastAPI/game server listens on. Agents connect here.
# Default: 8000
PORT=8000

# -----------------------------------------------------------------------------
# NOTE: No API key is needed for the pitch server — only the player/team
# agents require NVIDIA_API_KEY. Game constants (pitch size, physics, match
# duration, etc.) are fixed in pitch/config.py and are not set via .env.
# -----------------------------------------------------------------------------
